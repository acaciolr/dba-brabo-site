# artefatos locais que nao vao para o repositorio
.DS_Store
Thumbs.db
node_modules/
*.log

# ATENCAO: NAO ignorar arquivos com sufixo " 2".
# A sincronizacao renomeia arquivos em conflito (style.css -> "style 2.css").
# Se o git ignorar esses arquivos, o original aparece apenas como DELETADO no
# status e um commit distraido apaga o arquivo do repositorio — foi exatamente
# o que derrubou o site em 27/08. Eles precisam ficar VISIVEIS no git status.
# Duplicatas confirmadas vao para _conflitos/, que e ignorado abaixo.
_conflitos/
.git/_stale_locks/

# backup automatico do index.html original, feito antes da reformulacao
index.html.bak-original

# cache do Python gerado ao importar os scripts de tools/
__pycache__/
*.pyc

# Documentacao de trabalho: fica SO na pasta local, nao vai para o repositorio.
# Sao caminhos exatos de proposito — nada de "docs/*.md", porque
# docs/dominio-proprio.md e versionado e precisa continuar sendo.
docs/estado-atual.md
docs/terminal-web-spec.html
docs/plano-execucao.html
